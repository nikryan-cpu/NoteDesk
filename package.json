{
  "name": "notedesk",
  "productName": "NoteDesk",
  "version": "0.1.0",
  "description": "Unofficial lightweight desktop app for Gemini Notebook (ex-NotebookLM) & Gemini. Not affiliated with Google.",
  "main": "out/main/index.js",
  "author": "nikryan-cpu",
  "license": "MIT",
  "homepage": "https://github.com/nikryan-cpu/NoteDesk",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikryan-cpu/NoteDesk.git"
  },
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/run.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/render-icons.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.19.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}
